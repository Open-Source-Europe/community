{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/branch-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-baseline.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-wrapup-gate.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "n8n-skills@derberg-n8n-skills": true
  },
  "extraKnownMarketplaces": {
    "derberg-n8n-skills": {
      "source": {
        "source": "github",
        "repo": "derberg/n8n-skills"
      }
    }
  }
}
