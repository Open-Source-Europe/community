      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.opencollective.com/graphql/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "ose-automation/1.0 (n8n; issue #13)"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'query($s:String){account(slug:$s){slug hostApplicationRequests(limit:10,orderBy:{field:CREATED_AT,direction:DESC}){nodes{status createdAt host{slug}}}}}', variables: { s: $json.slug } }) }}",
        "options": {}
      }
    },
    {
      "id": "5c6d7e8f-9a0b-4c1d-8e2f-4a5b6c7d8e9f",
      "name": "Extract decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        160
      ],
      "parameters": {
        "jsCode": "// Pairs each status response with its state row (the HTTP node emits one\n// response per input row, in order) and keeps only rows whose application\n// was decided on Open Collective.\nconst rows = $('Still open?').all();\nconst out = [];\n$input.all().forEach((item, i) => {\n  const row = rows[i].json;\n  const account = item.json.data && item.json.data.account;\n  if (!account) return; // collective gone or renamed — leave the row for a human\n  const requests = (account.hostApplicationRequests || {}).nodes || [];\n  const forThisHost = requests.find((r) => r.host && r.host.slug === row.host_slug);\n  if (!forThisHost) return;\n  if (forThisHost.status === 'APPROVED' || forThisHost.status === 'REJECTED') {\n    out.push({ json: {\n      slug: row.slug,\n      org: row.org,\n      collective_name: row.collective_name,\n      applicant_email: row.contact_email || row.applicant_email || '',\n      decision: forThisHost.status.toLowerCase(),\n    }, pairedItem: { item: i } });\n  }\n});\nreturn out;"
      }
    },
    {
      "id": "6d7e8f9a-0b1c-4d2e-9f3a-5b6c7d8e9f0a",
      "name": "Send decision email",
      "notes": "Email first, then record: a failure between the two means a duplicate email on the next run, never a silently lost applicant.",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1320,
        160
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "EMVEYWzPEXkeapoM",
          "cachedResultName": "send-outbound"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "channel": "email",
            "to": "={{ $json.applicant_email }}",
            "template": "=decision-{{ $json.decision }}",
            "slug": "={{ $json.slug }}",
            "vars": "={{ { org: $json.org, collective_name: $json.collective_name } }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
