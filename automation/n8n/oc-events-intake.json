    {
      "id": "6f7a8b9c-0d1e-4f2a-9b3c-5d6e7f8a9b0c",
      "name": "Hosts to sync",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -160
      ],
      "parameters": {
        "jsCode": "// One item per fiscal host the automation watches. OCE runs two OC hosts\n// (EUR and USD); both map to the same org for forms and email copy.\nreturn [\n  { json: { host_slug: 'europe', org: 'OSE' } },\n  { json: { host_slug: 'oce-foundation-eur', org: 'OCE' } },\n  { json: { host_slug: 'oce-foundation-usd', org: 'OCE' } },\n];"
      }
    },
    {
      "id": "7a8b9c0d-1e2f-4a3b-8c4d-6e7f8a9b0c1d",
      "name": "Fetch pending applications",
      "notes": "Host.hostApplications requires host-admin auth: credential 'oc-host-admin' (Header Auth, header name Personal-Token) — select it here once the operator has created it.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        660,
        -160
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.opencollective.com/graphql/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "ose-automation/1.0 (n8n; issue #13)"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'query($h:String){host(slug:$h){slug hostApplications(limit:50,status:PENDING,orderBy:{field:CREATED_AT,direction:DESC}){totalCount nodes{createdAt message customData account{slug name description longDescription socialLinks{type url} members(role:ADMIN,limit:10){nodes{account{... on Individual{email}}}}}}}}}', variables: { h: $json.host_slug } }) }}",
        "options": {}
      }
    },
    {
      "id": "8b9c0d1e-2f3a-4b4c-9d5e-7f8a9b0c1d2e",
      "name": "Extract new applications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -160
      ],
      "parameters": {
        "jsCode": "// Flattens the per-host GraphQL responses into one item per pending\n// application, shaped exactly like an ose_applications row.\n// ONLY_SLUGS (a safety control — see automation/.env.example) restricts\n// processing to named collectives; empty means all.\nconst ORG_BY_HOST = { 'europe': 'OSE', 'oce-foundation-eur': 'OCE', 'oce-foundation-usd': 'OCE' };\nconst only = ($env.ONLY_SLUGS || '').split(',').map((s) => s.trim()).filter(Boolean);\nconst out = [];\nfor (const item of $input.all()) {\n  const host = item.json.data && item.json.data.host;\n  if (!host) {\n    throw new Error('intake: unexpected GraphQL response: ' + JSON.stringify(item.json.errors || item.json).slice(0, 500));\n  }\n  for (const node of host.hostApplications.nodes) {\n    const account = node.account || {};\n    if (!account.slug) continue;\n    if (only.length && !only.includes(account.slug)) continue;\n    const links = account.socialLinks || [];\n    const repoLink = links.find((l) => ['GITHUB', 'GITLAB', 'GIT_REPOSITORY'].includes(l.type));\n    const siteLink = links.find((l) => l.type === 'WEBSITE');\n    const adminEmails = ((account.members || {}).nodes || [])\n      .map((m) => (m.account || {}).email)\n      .filter(Boolean);\n    const custom = node.customData || {};\n    out.push({ json: {\n      slug: account.slug,\n      org: ORG_BY_HOST[host.slug] || host.slug,\n      host_slug: host.slug,\n      collective_name: account.name || account.slug,\n      collective_url: 'https://opencollective.com/' + account.slug,\n      description: account.description || '',\n      long_description: account.longDescription || '',\n      repository_url: (repoLink || {}).url || '',\n      website_url: (siteLink || {}).url || '',\n      application_message: node.message || '',\n      applicant_email: custom.email || custom.contactEmail || adminEmails[0] || '',\n      applied_at: node.createdAt,\n    }});\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "9c0d1e2f-3a4b-4c5d-8e6f-8a9b0c1d2e3f",
      "name": "Only new slugs",
      "notes": "Idempotency: a replayed webhook or an overlapping sweep converges here — existing rows pass through untouched, so stages only ever move forward.",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1100,
