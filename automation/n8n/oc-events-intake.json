    {
      "id": "2f3a4b5c-6d7e-4f8a-9b9c-1d2e3f4a5b6c",
      "name": "Still open?",
      "notes": "Terminal rows are dropped, which is what makes a replayed decision webhook silent: the second delivery finds the row already approved/rejected.",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        660,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
