    },
    {
      "id": "4b5c6d7e-8f9a-4b0c-9d1e-3f4a5b6c7d8e",
      "name": "Fetch application status",
      "notes": "Same 'oc-host-admin' credential as the pending fetch.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        880,
