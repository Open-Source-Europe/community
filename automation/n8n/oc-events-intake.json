              "id": "3a4b5c6d-7e8f-4a9b-8c0d-2e3f4a5b6c7d",
              "leftValue": "={{ !['approved', 'rejected'].includes($json.stage) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
