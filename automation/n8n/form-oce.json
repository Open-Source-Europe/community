          "__rl": true,
          "mode": "id",
          "value": "DVdak0e8uteziZRP",
          "cachedResultName": "ose_applications"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "slug",
              "condition": "eq",
              "keyValue": "={{ $json.slug }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      }
    },
    {
      "id": "aa718293-a4b5-4c6d-8437-708192a3b4c5",
      "name": "Application state",
      "notes": "The only page-1 checks the design needs: no row → apply on OC first; already submitted → first submission wins.",
