      "name": "Form page 1",
      "webhookId": "b2cc10b7-3cd9-4e41-a3f6-5500240a33d8",
      "notes": "Step 2 of applying to OCE. Page 1 asks only what the state lookup needs.",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Open Collective Europe — application form",
        "formDescription": "This is step 2 of applying for fiscal hosting with Open Collective Europe. Step 1 is applying on Open Collective — if you haven't yet, do that first and come back to this link.",
        "authentication": "none",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Contact email",
              "fieldType": "email",
              "requiredField": true,
              "placeholder": "you@example.org"
            },
            {
              "fieldLabel": "Your collective's Open Collective URL",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "https://opencollective.com/your-collective"
            }
          ]
        },
        "options": {
          "path": "apply-oce",
          "buttonLabel": "Continue"
        }
      }
    },
    {
      "id": "bb2c3d4e-5f60-4718-8982-2b3c4d5e6f70",
      "name": "Derive slug",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// n8n forms only have a Required rule, so URL shape is checked here.\n// The slug derived from the URL is what matches this submission to its\n// ose_applications row — there is no token in the form link.\nconst input = $input.first().json;\nconst rawUrl = String(input[\"Your collective's Open Collective URL\"] || '').trim();\nconst match = rawUrl.match(/^(?:https?:\\/\\/)?(?:www\\.)?opencollective\\.com\\/([A-Za-z0-9][A-Za-z0-9-]*)(?:[\\/?#].*)?$/);\nreturn [{ json: {\n  slug: match ? match[1].toLowerCase() : '',\n  contact_email: String(input['Contact email'] || '').trim(),\n  url_ok: !!match,\n} }];"
      }
    },
    {
      "id": "cc3d4e5f-6071-4829-8093-3c4d5e6f7081",
      "name": "Valid OC URL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "dd4e5f60-7182-493a-9104-4d5e6f708192",
              "leftValue": "={{ $json.url_ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ee5f6071-8293-4a4b-8215-5e6f708192a3",
