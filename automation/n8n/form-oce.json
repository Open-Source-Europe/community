        "respondWith": "text",
        "completionTitle": "That doesn't look like an Open Collective URL",
        "completionMessage": "We expected a link like https://opencollective.com/your-collective — the address of your collective's page on opencollective.com. Please open the form link again and paste that URL.",
        "limitWaitTime": false,
        "options": {}
      },
      "webhookId": "234c6c5b-ff09-4343-bd69-da39d2bbb9ff"
