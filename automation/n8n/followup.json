{
  "name": "apply 3 — follow-up: form invitation by verdict, one reminder, then Slack escalation",
  "nodes": [
    {
      "id": "f1a2b3c4-d5e6-4f7a-8b9c-1d2e3f4a5b6c",
      "name": "Follow-up schedule",
      "notes": "All timers are derived from stage + timestamps on the sweep cadence, never from Wait nodes, so a restart cannot drop a pending reminder. Shortening REMINDER_AFTER_MINUTES / ESCALATE_AFTER_MINUTES does nothing unless SWEEP_CRON shortens with them.",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "={{ $env.SWEEP_CRON }}"
            }
          ]
        }
      }
    },
    {
      "id": "a2b3c4d5-e6f7-4a8b-9c0d-2e3f4a5b6c7d",
      "name": "Get reviewed rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        -200
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "DVdak0e8uteziZRP",
          "cachedResultName": "ose_applications"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "stage",
              "condition": "eq",
              "keyValue": "reviewed"
            }
          ]
        },
        "returnAll": true
      }
    },
    {
      "id": "b3c4d5e6-f7a8-4b9c-8d0e-3f4a5b6c7d8e",
      "name": "Awaiting invitation",
      "notes": "Every reviewed application is invited to the form (decision 2026-09-01); the verdict only changes which email carries the invitation.",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        -200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c4d5e6f7-a8b9-4c0d-9e1f-4a5b6c7d8e9f",
              "leftValue": "={{ !$env.ONLY_SLUGS || $env.ONLY_SLUGS.split(',').map((s) => s.trim()).includes($json.slug) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d5e6f7a8-b9c0-4d1e-8f2a-5b6c7d8e9f0a",
      "name": "Send form invitation",
      "notes": "fits → step2-invite; wrong_host → advised-wrong-host; not_open_source and unclear → advised-not-open-source (its copy covers 'could not tell'). All four templates carry the form link.",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        660,
        -200
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "EMVEYWzPEXkeapoM",
          "cachedResultName": "apply 0 — send-outbound: the single door for every email and Slack message (DRY_RUN gate)"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "channel": "email",
            "to": "={{ $json.contact_email || $json.applicant_email }}",
            "template": "={{ $json.ai_verdict === 'fits' ? 'step2-invite' : ($json.ai_verdict === 'wrong_host' ? 'advised-wrong-host' : 'advised-not-open-source') }}",
            "slug": "={{ $json.slug }}",
            "vars": "={{ { org: $json.org, collective_name: $json.collective_name, ai_applicant_message: $json.ai_applicant_message } }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
