              "id": "b9c0d1e2-f3a4-4b5c-8d6e-9f0a1b2c3d4e",
              "leftValue": "={{ (!$env.ONLY_SLUGS || $env.ONLY_SLUGS.split(',').map((s) => s.trim()).includes($json.slug)) && !$json.form_reminded_at && !!$json.form_invited_at && DateTime.fromISO($json.form_invited_at) < $now.minus({ minutes: Number($env.REMINDER_AFTER_MINUTES || 10080) }) }}",
